# ============================================================
# KONFIGURACJA SERWERA — zmień PRZED uruchomieniem na serwerze
# ============================================================

# IP lub domena serwera (bez trailing slash)
# Lokalnie: http://localhost:3000
# Na serwerze: http://1.2.3.4:3000 lub https://twojaapp.pl
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================================
# BAZA DANYCH
# ============================================================
DB_USER=admin
DB_PASSWORD=secret_password_here
DB_NAME=aplikacja_db

# ============================================================
# BEZPIECZEŃSTWO
# ============================================================
JWT_SECRET=your_secure_jwt_secret_key

# ============================================================
# ŚCIEŻKA DO PLIKÓW LYNX (FinishLynx)
# Linux/Mac: ścieżka bezwzględna np. /home/user/lynx_data lub ./lynx_data (względna)
# Windows lokalnie: C:/Zawody
# ============================================================
LYNX_DATA_PATH=./lynx_data

# ============================================================
# KOD ZAPROSZENIA DO REJESTRACJI
# ============================================================
REGISTRATION_INVITE_CODE=20d890c170a56ebb66e440cc18b7a954d7322aec44e417a01c77300635d51c1d
