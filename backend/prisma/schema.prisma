// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  COACH
  ATHLETE
  USER
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  firstName      String
  lastName       String
  role           Role      @default(USER)

  // Email verification
  emailVerified  Boolean   @default(false)
  emailToken     String?   @unique

  // Profile fields (ATHLETE / COACH)
  dateOfBirth    DateTime?
  clubName       String?   // "niestowarzyszony" or club name
  licenseNumber  String?
  phoneNumber    String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  meetings       Meeting[]
}

enum MeetingSeason {
  STADIUM
  INDOOR
}

enum MeetingType {
  INTERNATIONAL
  NATIONAL
  REGIONAL
  SCHOOL
  TRAINING
  TEST
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  OPEN
  FINISHED
  CANCELLED
}

model Meeting {
  id            String        @id @default(uuid())
  name          String
  date          DateTime
  endDate       DateTime?
  location      String
  city          String?
  country       String?       @default("POL")
  domtelMeetingCode String?
  season        MeetingSeason @default(STADIUM)
  type          MeetingType   @default(REGIONAL)
  status        MeetingStatus @default(DRAFT)
  organizer     User          @relation(fields: [organizerId], references: [id])
  organizerId   String
  organizerLogo String?
  sponsorLogos  String[] // URLs or paths to sponsor logos
  syncOnlineEventNames Boolean @default(false)
  teamScoringEnabled Boolean @default(false)
  teamScoringTable   String? // JSON array of points by place, e.g. [15,12,10,9,8,8,7,7,6,5,4,3,2,2,2,2]
  events        Event[]
  activityLogs  ActivityLog[]
  records       Record[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Event {
  id             String   @id @default(uuid())
  name           String
  code           String
  eventCode      String? // Roster Athletics event code (e.g., "60", "100", "HJ")
  gender         String // M, K, MIX
  ageGroup       String? // U16, U18, U20, Senior
  stage          String   @default("Final") // Heat, Semi-Final, Final, etc.
  model          String?  // Roster Athletics competition model (Standard, Field 3+3, etc.)
  trialsMode     String?  // "3", "4", "3+3" (6), "6"
  requiresWind   Boolean  @default(false)
  startTime      DateTime?
  completedTime  String?
  heights        String? // JSON array of heights for vertical jumps, e.g., "[1.40, 1.45, 1.50]"
  lanes          Int      @default(8)
  finalStartTime DateTime?
  finalCount     Int?      @default(1)
  finalInterval  Int?      @default(5)
  finalStartTimes String?   // JSON array of ISO strings
  advancementRule String?  // e.g. "8 to final" or "3Q + 2q"
  advPerHeat      Int?     // Q: how many athletes advance per heat by place
  advByTime       Int?     // q: how many additional athletes advance by best time
  weather         String?  // JSON: { temperature, humidity, conditions, notes }
  referee         String?  // Judge/referee name for this event
  meeting        Meeting    @relation(fields: [meetingId], references: [id])
  meetingId      String
  entries        Entry[]
  judges         EventJudge[]
  parentEvent    Event?    @relation("SubEvents", fields: [parentEventId], references: [id])
  parentEventId  String?
  subEvents      Event[]   @relation("SubEvents")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum EntryStatus {
  PENDING
  CONFIRMED
  SCRATCHED
}

model Entry {
  id             String      @id @default(uuid())
  // Name fields - backwards compatible
  athleteName    String
  firstName      String?
  middleName     String?
  lastName       String?
  
  // Identity
  bib            String?
  club           String?
  countryCode    String?     @default("POL")
  dateOfBirth    DateTime?
  yearOfBirth    Int?
  gender         String?     // M, K - can be different from event gender for mixed events
  
  // External IDs
  tilastopajaId  String?     // Tilastopaja ID (Finnish statistics)
  entryId        String?     // Roster Athletics Entry ID
  startListId    String?     // Roster Athletics StartList ID
  
  // Performance data
  pb             String?     // Personal Best
  sb             String?     // Season Best
  seedingResult  String?     // Seeding result for placement
  
  // Race assignment
  heat           Int?
  lane           Int?
  isPk           Boolean     @default(false) // Poza Konkursem — nie liczy się do rankingu

  // Relations
  event          Event       @relation(fields: [eventId], references: [id])
  eventId        String
  athlete        Athlete?    @relation(fields: [athleteId], references: [id])
  athleteId      String?
  clubRef        Club?       @relation(fields: [clubId], references: [id])
  clubId         String?
  status         EntryStatus @default(PENDING)
  result         Result?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relay specific
  relaySquad     String?     // JSON array of relay members [{firstName, lastName, ...}]
}

model Result {
  id             String   @id @default(uuid())
  
  // Placement
  place          Int?
  placeGender    Int?     // Place within gender category
  
  // Track event results
  time           String?  // Final time/result
  resultRounded  String?  // Rounded result for display
  wind           Float?   // Wind reading (m/s)
  windReading    String?  // Wind as string (for display)
  reactionTime   Float?
  
  // Field event trials (for throws/jumps)
  round1Result   String?  // "X", "O", "-", or distance/height
  round1Wind     Float?
  round2Result   String?
  round2Wind     Float?
  round3Result   String?
  round3Wind     Float?
  round4Result   String?
  round4Wind     Float?
  round5Result   String?
  round5Wind     Float?
  round6Result   String?
  round6Wind     Float?
  bestResult     String?  // Best result from all rounds
  
  // Detailed results for technical events
  verticalJSON   String?  // JSON string: { "1.40": "O", "1.45": "XO", "1.50": "XXX" }
  fieldJSON      String?  // JSON array of attempts: ["12.45", "X", "13.01", ...]
  
  // Status
  status         String   @default("OK") // OK, DNS, DNF, DQ, NM
  points         Int?

  // Split times (intermediate times for distance events)
  splits         String?  // JSON array: [{ distance: 200, time: "22.45" }, ...]
  
  // Relations
  entry          Entry    @relation(fields: [entryId], references: [id])
  entryId        String   @unique
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model Record {
  id          String   @id @default(uuid())
  meetingId   String?  // null = global record
  season      String   // "L" = outdoor, "Z" = indoor
  category    String   // Open, U23, U20, U18, U16, U14
  recordType  String   // "PR" = Poland Record, "ER" = Europe, "WR" = World, "MR" = Meeting record
  eventCode   String   // competition code, e.g. "100m", "LJ"
  gender      String   // M, K
  performance String   // result value, e.g. "9.86" or "1:20.15"
  athleteName String?
  club        String?
  location    String?
  date        DateTime?
  wind        String?

  meeting     Meeting? @relation(fields: [meetingId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid())
  meetingId   String
  actorId     String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())

  meeting     Meeting  @relation(fields: [meetingId], references: [id])
}

model Athlete {
  id             String    @id @default(uuid())
  firstName      String?
  lastName       String?
  athleteName    String    // Full name or display name

  gender         String?
  club           String?
  clubId         String?
  countryCode    String?   @default("POL")
  birthDate      DateTime?
  yearOfBirth    Int?

  // PZLA identifiers
  pzlaId         Int?      // NrZawodnika from legacy baza table
  licenseNumber  String?   // Nr rejestracji / Licencja_Nr
  licenseYear    Int?
  licenseValid   String?   // Licencja_waznosc

  // Performance Summary
  pb             String?
  sb             String?

  entries        Entry[]
  clubRef        Club?     @relation(fields: [clubId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([pzlaId])
  @@index([lastName, firstName])
}

model Club {
  id            String    @id @default(uuid())
  shortName     String    // SkrótKlubu
  fullName      String?   // NazwaPelna
  city          String?
  voivodeship   String?   // woj
  pzlaId        Int?      // NrKlubu from legacy — unique PZLA number
  licenseNr     Int?
  licenseYear   Int?
  website       String?

  athletes      Athlete[]
  entries       Entry[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([pzlaId])
  @@index([shortName])
}

model Judge {
  id             String       @id @default(uuid())
  licenseNumber  Int?         @unique  // NrLicencji
  firstName      String
  lastName       String
  birthDate      DateTime?
  voivodeship    String?
  judgeClass     String?      // "Sędzia" | "SedziaOkregowy" | "SedziaZwiazkowy" | "SedziaMiedzynarodowy"
  courseYear     String?      // UkonczenieKursu

  assignments    EventJudge[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([lastName, firstName])
}

model EventJudge {
  id          String   @id @default(uuid())
  eventId     String
  judgeId     String
  function    String   // "Sędzia główny", "Sędzia pola", "Mierzący", etc.
  sortOrder   Int?

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge       Judge    @relation(fields: [judgeId], references: [id])

  @@unique([eventId, judgeId, function])
}
