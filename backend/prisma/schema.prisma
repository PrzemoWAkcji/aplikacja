// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  USER
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  meetings  Meeting[]
}

enum MeetingSeason {
  STADIUM
  INDOOR
}

enum MeetingType {
  INTERNATIONAL
  NATIONAL
  REGIONAL
  SCHOOL
  TRAINING
  TEST
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  OPEN
  FINISHED
  CANCELLED
}

model Meeting {
  id            String        @id @default(uuid())
  name          String
  date          DateTime
  endDate       DateTime?
  location      String
  city          String?
  country       String?       @default("POL")
  domtelMeetingCode String?
  season        MeetingSeason @default(STADIUM)
  type          MeetingType   @default(REGIONAL)
  status        MeetingStatus @default(DRAFT)
  organizer     User          @relation(fields: [organizerId], references: [id])
  organizerId   String
  organizerLogo String?
  sponsorLogos  String[] // URLs or paths to sponsor logos
  syncOnlineEventNames Boolean @default(false)
  events        Event[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Event {
  id             String   @id @default(uuid())
  name           String
  code           String
  eventCode      String? // Roster Athletics event code (e.g., "60", "100", "HJ")
  gender         String // M, K, MIX
  ageGroup       String? // U16, U18, U20, Senior
  stage          String   @default("Final") // Heat, Semi-Final, Final, etc.
  model          String?  // Roster Athletics competition model (Standard, Field 3+3, etc.)
  trialsMode     String?  // "3", "4", "3+3" (6), "6"
  requiresWind   Boolean  @default(false)
  startTime      DateTime?
  completedTime  String?
  heights        String? // JSON array of heights for vertical jumps, e.g., "[1.40, 1.45, 1.50]"
  lanes          Int      @default(8)
  finalStartTime DateTime?
  finalCount     Int?      @default(1)
  finalInterval  Int?      @default(5)
  finalStartTimes String?   // JSON array of ISO strings
  advancementRule String?  // e.g. "8 to final" or "3Q + 2q"
  meeting        Meeting  @relation(fields: [meetingId], references: [id])
  meetingId      String
  entries        Entry[]
  parentEvent    Event?    @relation("SubEvents", fields: [parentEventId], references: [id])
  parentEventId  String?
  subEvents      Event[]   @relation("SubEvents")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum EntryStatus {
  PENDING
  CONFIRMED
  SCRATCHED
}

model Entry {
  id             String      @id @default(uuid())
  // Name fields - backwards compatible
  athleteName    String
  firstName      String?
  middleName     String?
  lastName       String?
  
  // Identity
  bib            String?
  club           String?
  countryCode    String?     @default("POL")
  dateOfBirth    DateTime?
  yearOfBirth    Int?
  gender         String?     // M, K - can be different from event gender for mixed events
  
  // External IDs
  tilastopajaId  String?     // Tilastopaja ID (Finnish statistics)
  entryId        String?     // Roster Athletics Entry ID
  startListId    String?     // Roster Athletics StartList ID
  
  // Performance data
  pb             String?     // Personal Best
  sb             String?     // Season Best
  seedingResult  String?     // Seeding result for placement
  
  // Race assignment
  heat           Int?
  lane           Int?
  
  // Relations
  event          Event       @relation(fields: [eventId], references: [id])
  eventId        String
  athlete        Athlete?    @relation(fields: [athleteId], references: [id])
  athleteId      String?
  status         EntryStatus @default(PENDING)
  result         Result?
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relay specific
  relaySquad     String?     // JSON array of relay members [{firstName, lastName, ...}]
}

model Result {
  id             String   @id @default(uuid())
  
  // Placement
  place          Int?
  placeGender    Int?     // Place within gender category
  
  // Track event results
  time           String?  // Final time/result
  resultRounded  String?  // Rounded result for display
  wind           Float?   // Wind reading (m/s)
  windReading    String?  // Wind as string (for display)
  reactionTime   Float?
  
  // Field event trials (for throws/jumps)
  round1Result   String?  // "X", "O", "-", or distance/height
  round1Wind     Float?
  round2Result   String?
  round2Wind     Float?
  round3Result   String?
  round3Wind     Float?
  round4Result   String?
  round4Wind     Float?
  round5Result   String?
  round5Wind     Float?
  round6Result   String?
  round6Wind     Float?
  bestResult     String?  // Best result from all rounds
  
  // Detailed results for technical events
  verticalJSON   String?  // JSON string: { "1.40": "O", "1.45": "XO", "1.50": "XXX" }
  fieldJSON      String?  // JSON array of attempts: ["12.45", "X", "13.01", ...]
  
  // Status
  status         String   @default("OK") // OK, DNS, DNF, DQ, NM
  points         Int?
  
  // Relations
  entry          Entry    @relation(fields: [entryId], references: [id])
  entryId        String   @unique
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model Athlete {
  id             String    @id @default(uuid())
  // Use unique key? Or just search? 
  // Let us store full name
  firstName      String?
  lastName       String?
  athleteName    String    // Full name or display name

  gender         String?
  club           String?
  countryCode    String?   @default("POL")
  birthDate      DateTime?
  yearOfBirth    Int?
  
  // Performance Summary
  pb             String?   
  sb             String?
  
  entries        Entry[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
